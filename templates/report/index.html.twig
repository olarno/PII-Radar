{% extends 'base.html.twig' %}
{% block title %}Rapport · PII Radar{% endblock %}
{% block body %}
    <h1>Rapport de données personnelles</h1>
    {{ include('report/_provenance.html.twig') }}

    <div class="cards">
        {% for severity, item in by_severity %}
            <div class="card"><span class="{{ severity }}">{{ item.label }}</span><strong>{{ item.count }}</strong></div>
        {% endfor %}
        <div class="card"><span>Données personnelles</span><strong>{{ personal|length }}</strong></div>
    </div>

    <p>Registre (brouillon) : <a href="{{ path('report_register', {format: 'loi25'}) }}">Loi 25</a> · <a href="{{ path('report_register', {format: 'rgpd'}) }}">RGPD</a></p>

    <section id="flow-map">
    <h2>Carte des flux</h2>
    <p class="muted">Formulaires, tables, journaux et destinataires des données personnelles. En rouge : ce qui demande une action.</p>
    <pre class="mermaid">{{ flow_map }}</pre>
    </section>

    <section id="findings">
    <h2>Findings ({{ report.findings|length }})</h2>
    <div class="scroll"><table>
        <thead><tr><th>Règle</th><th>Sévérité</th><th>Preuve</th><th>Constat</th><th>Correctif</th></tr></thead>
        <tbody>
        {% for finding in report.findings %}
            <tr>
                <td><strong>{{ finding.rule }}</strong></td>
                <td><span class="badge {{ finding.severity.value }}">{{ finding.severity.label() }}</span></td>
                <td><code>{{ finding.location }}</code></td>
                <td>{{ finding.summary }}</td>
                <td>{{ finding.remediation }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    </section>

    <section id="personal">
    <h2>Données personnelles ({{ personal|length }})</h2>
    <div class="scroll"><table>
        <thead><tr><th>Champ</th><th>Catégorie</th><th>Sensibilité</th><th>Décidé par</th><th>Justification</th></tr></thead>
        <tbody>
        {% for field in personal %}
            <tr>
                <td><a href="{{ path('report_field', {table: field.column.reference.table, column: field.column.reference.column}) }}"><code>{{ field.column.reference }}</code></a></td>
                <td>{{ field.category.label() }}</td>
                <td><span class="badge {{ field.sensitivity.value == 'high' ? 'critical' : (field.sensitivity.value == 'medium' ? 'medium' : 'low') }}">{{ field.sensitivity.label() }}</span></td>
                <td>{{ field.decidedBy.value == 'agent' ? 'Agent IA' : 'Règles' }} ({{ (field.confidence * 100)|round }} %)</td>
                <td>{{ field.justification }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    </section>

    {% if rejected is not empty %}
        <section id="rejected">
        <h2>Écartées ({{ rejected|length }})</h2>
        <p class="muted">Leur nom ressemble à une donnée personnelle, mais l'examen montre que ce n'en est pas.</p>
        <ul>
        {% for field in rejected %}
            <li><code>{{ field.column.reference }}</code> : {{ field.justification }} <span class="muted">({{ field.decidedBy.value == 'agent' ? 'agent IA' : 'règles' }})</span></li>
        {% endfor %}
        </ul>
        </section>
    {% endif %}
{% endblock %}
