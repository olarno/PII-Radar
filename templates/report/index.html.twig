{% extends 'base.html.twig' %}
{% block title %}Report · PII Radar{% endblock %}
{% block body %}
    <h1>Personal data report</h1>
    {{ include('report/_provenance.html.twig') }}

    <div class="cards">
        {% for severity, item in by_severity %}
            <div class="card"><span class="{{ severity }}">{{ item.label }}</span><strong>{{ item.count }}</strong></div>
        {% endfor %}
        <div class="card"><span>Personal data</span><strong>{{ personal|length }}</strong></div>
    </div>

    <p>Register (draft): <a href="{{ path('report_register', {format: 'law25'}) }}">Quebec Law 25</a> · <a href="{{ path('report_register', {format: 'gdpr'}) }}">GDPR</a></p>

    <section id="flow-map">
    <h2>Flow map</h2>
    <p class="muted">Forms, tables, logs and recipients of personal data. In red: what needs action.</p>
    <pre class="mermaid">{{ flow_map }}</pre>
    </section>

    <section id="findings">
    <h2>Findings ({{ report.findings|length }})</h2>
    <div class="scroll"><table>
        <thead><tr><th>Rule</th><th>Severity</th><th>Evidence</th><th>Finding</th><th>Fix</th></tr></thead>
        <tbody>
        {% for finding in report.findings %}
            <tr>
                <td><strong>{{ finding.rule }}</strong></td>
                <td><span class="badge {{ finding.severity.value }}">{{ finding.severity.label() }}</span></td>
                <td><code>{{ finding.location }}</code></td>
                <td>{{ finding.summary }}</td>
                <td>{{ finding.remediation }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    </section>

    <section id="personal">
    <h2>Personal data ({{ personal|length }})</h2>
    <div class="scroll"><table>
        <thead><tr><th>Field</th><th>Category</th><th>Sensitivity</th><th>Decided by</th><th>Justification</th></tr></thead>
        <tbody>
        {% for field in personal %}
            <tr>
                <td><a href="{{ path('report_field', {table: field.column.reference.table, column: field.column.reference.column}) }}"><code>{{ field.column.reference }}</code></a></td>
                <td>{{ field.category.label() }}</td>
                <td><span class="badge {{ field.sensitivity.value == 'high' ? 'critical' : (field.sensitivity.value == 'medium' ? 'medium' : 'low') }}">{{ field.sensitivity.label() }}</span></td>
                <td>{{ field.decidedBy.value == 'agent' ? 'AI agent' : 'Rules' }} ({{ (field.confidence * 100)|round }}%)</td>
                <td>{{ field.justification }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    </section>

    {% if rejected is not empty %}
        <section id="rejected">
        <h2>Rejected ({{ rejected|length }})</h2>
        <p class="muted">Their name looks like personal data, but examination shows they are not.</p>
        <ul>
        {% for field in rejected %}
            <li><code>{{ field.column.reference }}</code> : {{ field.justification }} <span class="muted">({{ field.decidedBy.value == 'agent' ? 'AI agent' : 'rules' }})</span></li>
        {% endfor %}
        </ul>
        </section>
    {% endif %}
{% endblock %}
