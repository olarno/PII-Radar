# Committed defaults. Put real secrets in .env.local (git-ignored), never here.
# https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> symfony/ai-hugging-face-platform ###
# Hugging Face access token (https://huggingface.co/settings/tokens).
# Required for a real scan; tests and CI run without it.
HUGGINGFACE_API_KEY=
###< symfony/ai-hugging-face-platform ###
